        "reference_type": "git-commit",
        "reference": "1111111111111111111111111111111111111111",
        "digest": {
          "algorithm": "sha256",
          "value": "1111111111111111111111111111111111111111111111111111111111111111"
        }
      },
      "target": {
        "path": "AGENTS.md",
        "management": "generated",
        "owner": "example/consumer",
        "generator": "example/holon"
      },
      "compatibility": {
        "contract": "example.aether.agent-bundle/v1",
