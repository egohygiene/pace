{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/pace/contracts/fleet-convergence-plan/v1/schema.json",
  "title": "Pace fleet convergence plan v1",
  "$comment": "Canonical digest, dependency order, external-contract semantics, and exact review state are enforced by scripts/plan_fleet_convergence.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sources", "policy", "review", "summary", "units", "plan_digest"],
  "properties": {
    "schema": { "const": "egohygiene.pace.fleet-convergence-plan/v1" },
    "sources": { "type": "object" },
    "policy": { "type": "object" },
    "review": { "type": "object" },
    "summary": { "type": "object" },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "unit_id", "order", "repository", "disposition", "risk", "blockers",
          "depends_on", "changes", "current_lock_present", "current_lock", "desired_lock"
        ],
        "properties": {
          "unit_id": { "type": "string", "pattern": "^upgrade:[a-z0-9_.-]+/[a-z0-9_.-]+:[0-9a-f]{12}$" },
          "order": { "type": "integer", "minimum": 1 },
          "repository": { "type": "string" },
          "disposition": { "enum": ["ready_for_review", "blocked", "paused", "no_change"] },
          "risk": { "enum": ["low", "medium", "high"] },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "changes": { "type": "array", "items": { "type": "object" } },
          "current_lock_present": { "type": "boolean" }
        }
      }
    },
    "plan_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
