{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/pace/contracts/repository-presentation/review/v1/schema.json",
  "title": "Pace reviewed-plan authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "planDigest",
    "reviewer",
    "reviewedAt",
    "decision"
  ],
  "properties": {
    "schema": {
      "const": "egohygiene.pace.repository-presentation-review/v1"
    },
    "planDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "const": "approved"
    }
  }
}
